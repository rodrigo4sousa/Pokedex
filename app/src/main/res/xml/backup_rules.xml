<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (android:fullBackupContent).
   minSdk is 31, so this file is not used today; it mirrors data_extraction_rules.xml so the
   decision stays the same if minSdk is ever lowered.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="database" path="pokedex.db" />
    <include domain="database" path="pokedex.db-wal" />
</full-backup-content>
