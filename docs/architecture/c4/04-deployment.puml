' C4 Deployment - what exists today
' Version 1.3 - 2026-10-21
' Only existing elements. Play Store publication and CI are planned: see 04-deployment-planned.puml.
' The app is not published; it runs as a locally installed APK. No backend, no cloud services.
' Not drawn: Android Auto Backup / device transfer. Explicit rules (backup_rules.xml, data_extraction_rules.xml)
' keep only pokedex.db and its WAL file - noted in the README.
' Sprites (PokeAPI/sprites) and cries (PokeAPI/cries) are two GitHub repositories on the same host.
@startuml 04-deployment
!include <C4/C4_Deployment>
!include ../style.puml

LAYOUT_LEFT_RIGHT()

title Deployment - current

Deployment_Node(device, "Android device", "Android 12+ (minSdk 31)") {
    Deployment_Node(sandbox, "App sandbox", "com.example.pokedex") {
        Container(androidApp, "Android App", "Kotlin, Jetpack Compose, Hilt", "Requires INTERNET permission")
        ContainerDb(localDb, "Local Database", "Room / SQLite", "pokedex.db in app internal storage")
    }
}

Deployment_Node(pokeApiNode, "pokeapi.co", "Public HTTPS host") {
    System_Ext(pokeApi, "PokeAPI")
}

Deployment_Node(githubRawNode, "raw.githubusercontent.com", "Public HTTPS host") {
    System_Ext(spritesHost, "PokeAPI Sprites (GitHub raw)")
    System_Ext(criesHost, "PokeAPI Cries (GitHub raw)")
}

Rel(androidApp, localDb, $plain("Stores catches, game progress"), "Room DAOs")
Rel(androidApp, pokeApi, $plain("Reads Pokémon data"), "Retrofit, HTTPS/JSON")
Rel(androidApp, spritesHost, $plain("Loads sprite images"), "Coil, HTTPS")
Rel(androidApp, criesHost, $plain("Streams Pokémon cries"), "MediaPlayer, HTTPS")
@enduml
