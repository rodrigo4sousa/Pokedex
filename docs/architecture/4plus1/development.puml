' 4+1 Development view - UML package diagram
' Version 1.3 - 2026-10-20
' For: developers finding their way in the code and planning refactors. Documents the decision to keep a
' single app module (:app) organised by layer, plus a test-only module (:testing) for code shared by
' src/test and src/androidTest:
' - presentation depends on data (PokemonRepository) and domain.model only;
' - data.remote (Retrofit, DTOs) and data.local (Room) stay inside the data layer; data.mapper turns their
'   types into domain.model, which depends on nothing else.
' Arrows are import dependencies, labelled with what is imported (from the imports in app/src/main).
' Arrows from `presentation` group its subpackages: data and domain.model (home, pokedex, pokemonDetail).
' Package names below com.example.pokedex are shown relative to it (data.local = com.example.pokedex.data.local).
' :testing is plain Kotlin/JVM with no app classes: recorded PokeAPI fixtures (resources) and PokeApiDispatcher.
' :app's test source sets (src/test, src/androidTest) are not drawn as packages; they depend on :testing.
@startuml development
!include ../style.puml

title Development view - packages of :app

set separator none
left to right direction

package ":app module" {
    package "com.example.pokedex"
    package "ui.theme"
    package "presentation" {
        package "navigation"
        package "home"
        package "pokedex"
        package "pokemonDetail"
        package "components"
    }
    package "domain.model"
    package "data"
    package "data.mapper"
    package "data.remote"
    package "data.remote.dto"
    package "data.local"
}

package ":testing module (test only)" {
    package "testing"
}

"com.example.pokedex" --> "navigation" : Navigation
"com.example.pokedex" --> "ui.theme" : PokedexTheme

"navigation" --> "home" : HomeScreen
"navigation" --> "pokedex" : PokedexScreen
"navigation" --> "pokemonDetail" : PokemonDetailScreen

"home" --> "components" : grid, search, sort, filter
"pokedex" --> "components" : grid, search, sort, filter
"pokemonDetail" --> "components" : star, typeColor
"components" --> "domain.model" : PokemonSummary

"presentation" --> "data" : PokemonRepository
"presentation" --> "domain.model" : models

"data" --> "data.remote" : PokemonApi
"data" --> "data.local" : CaughtPokemonDao
"data" --> "data.mapper" : mappers
"data" --> "domain.model" : models
"data.remote" --> "data.remote.dto" : DTOs
"data.mapper" --> "data.remote.dto" : DTOs
"data.mapper" --> "data.local" : CaughtPokemonEntity
"data.mapper" --> "domain.model" : models

":app module" ..> "testing" : testImplementation,\nandroidTestImplementation
@enduml
